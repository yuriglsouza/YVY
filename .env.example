# API Keys
GEMINI_API_KEY=
SATELLITE_API_KEY=
DATABASE_URL=

# AI Configuration
# Sugestão: gemini-2.5-flash ou gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
HEARTBEAT_SECRET=

# Google Earth Engine (GEE) Configuration
# GEE_PROJECT_ID=seu-projeto-id
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type": "service_account", ...}
ALLOW_SIMULATED_SATELLITE_DATA=false

# Outras configurações
NODE_ENV=development
PORT=5000

# Supabase Storage (Para imagens persistentes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=satellite-images
